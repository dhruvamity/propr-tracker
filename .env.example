# ─── Propr Trading Terminal ──────────────────────────────────────────────────
# Environment variables. Copy to .env and fill in your values.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your Propr API key (starts with pk_live_)
# Get it at https://app.propr.xyz/settings
PROPR_API_KEY=pk_live_your_key_here

# ─── OPTIONAL: Redis/KV ─────────────────────────────────────────────────────

# Redis URL for persistent state (used by sync worker + frontend)
# If not set, uses in-memory store (data lost on restart)
# For Vercel KV: use the KV_URL from Vercel dashboard
REDIS_URL=

# Vercel KV specific (auto-set when using Vercel KV addon)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# ─── OPTIONAL: Configuration ────────────────────────────────────────────────

# USD to INR exchange rate for display purposes
USD_TO_INR=84.5

# Effective INR rate per USD for dynamic Paysagi Bucharest card debits
# Calibrated to ₹97.82/USD based on Bank of Baroda debits (includes bank forex markup + GST)
PAYSAGI_EFFECTIVE_RATE=97.82

# "Near breach" threshold (% of max drawdown used before showing warning)
NEAR_BREACH_THRESHOLD_PERCENT=80

# "Near target" threshold (% of profit target reached before showing highlight)
NEAR_TARGET_THRESHOLD_PERCENT=80

# Data freshness thresholds (seconds)
STALE_THRESHOLD_SECONDS=30
OFFLINE_THRESHOLD_SECONDS=120

# WebSocket URL (defaults to wss://api.propr.xyz/ws)
# PROPR_WS_URL=wss://api.propr.xyz/ws

# REST API base URL (defaults to https://api.propr.xyz/v1)
# PROPR_API_URL=https://api.propr.xyz/v1
